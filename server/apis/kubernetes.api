type (
	PatchWorkloadReq {
		Cluster      string `path:"cluster"`
		Namespace    string `path:"namespace"`
    WorkloadType string `path:"workload_type"`
		WorkloadName string `path:"workload_name"`
		Container    string `form:"container"`
		Image        string `form:"image"`
	}
	ListWorkloadReq {
		Cluster       string `path:"cluster"`
		Namespace     string `path:"namespace"`
		LabelSelector string `form:"label_selector,optional"`
	}
	RolloutReq {
		Cluster      string `path:"cluster"`
		Namespace    string `path:"namespace"`
    WorkloadType string `path:"workload_type,optional"`
		WorkloadName string `path:"workload_name"`
	}
  ListResourceReq {
		Cluster       string `path:"cluster"`
		Namespace     string `path:"namespace"`
    ResourceType  string `path:"resource_type"`
		LabelSelector string `form:"label_selector,optional"`
    FieldSelector string `form:"field_selector,optional"`
    Continue      string `form:"continue,optional"`
    Limit         int64  `form:"limit,optional"`
	}
	ResourceReq {
		Cluster      string `path:"cluster"`
		Namespace    string `path:"namespace"`
		ResourceType string `path:"resource_type"`
		ResourceName string `path:"resource_name,optional"`
    WithStatus   string `form:"withStatus,optional"`
    Force        bool   `form:"force,optional"`
	}
	PatchVariableReq {
		Cluster   string                 `path:"cluster"`
		Namespace string                 `path:"namespace"`
		Kind      string                 `form:"kind,optional"`
		Content   string                 `json:"content"`
		Variables map[string]interface{} `json:"variables,optional"`
	}
	PatchYamlReq {
		Cluster   string `path:"cluster"`
		Namespace string `path:"namespace"`
		Kind      string `form:"kind,optional"`
	}
	ScaleReq {
		Cluster       string          `path:"cluster"`
		Namespace     string          `path:"namespace"`
    WorkloadType  string          `path:"workload_type"`
		Workloads     []ScaleWorkload `json:"workloads"`
	}
	ScaleWorkload {
		Name     string `json:"name"`
		Replicas int    `json:"replicas"`
		Disabled bool   `json:"disabled,optional"`
	}
  ReplicaReq {
    Cluster       string   `path:"cluster"`
		Namespace     string   `path:"namespace"`
    WorkloadType  string   `path:"workload_type"`
    Workloads     []string `json:"workloads"`
    InitContainer bool     `json:"initContainer,optional"`
  }
	GetServiceReq {
		ServiceName string `path:"service_name"`
	}
	ListTagsReq {
		AppName string `form:"app_name"`
    Tag string `form:"tag,optional"`
	}
  PodLogReq {
		Cluster    string `path:"cluster"`
		Namespace  string `path:"namespace"`
    PodName    string `path:"pod_name"`
		Container  string `form:"container"`
    Lines      int64  `form:"lines,optional"`
    Follow     bool   `form:"follow,optional"`
    Timestamps bool   `form:"timestamps,optional"`
  }
  HpaReq {
    Cluster      string `path:"cluster"`
		Namespace    string `path:"namespace"`
    WorkloadName string `path:"workload_name"`
    Max          int32  `json:"max"`
    Min          int32  `json:"min"`
    Cpu          int32  `json:"cpu,optional"`
    Memory       int32  `json:"memory,optional"`
  }
  FetchYamlReq {
		Content   string                 `json:"content"`
		Variables map[string]interface{} `json:"variables,optional"`
	}
  PatchConfigReq {
    Cluster      string `path:"cluster"`
		Namespace    string `path:"namespace"`
    ResourceType string `path:"resource_type"`
    ResourceName string `path:"resource_name"`
    Key          string `json:"key"`
    Value        string `json:"value"`
  }
)
@server(
	prefix: /lizardcd/kubernetes
	group: kubernetes
	jwt: Auth
  middleware: Validateuser
)
service lizardServer {
	@doc(
		summary: 更新workload
	)
	@handler patchWorkload
	patch /cluster/:cluster/namespace/:namespace/:workload_type/:workload_name (PatchWorkloadReq) returns (Response)
	
	@doc(
		summary: 重启workload
	)
	@handler rolloutWorkload
	patch /cluster/:cluster/namespace/:namespace/:workload_type/:workload_name/rollout (RolloutReq) returns (Response)
	
	@doc(
		summary: 设置workload副本数
	)
	@handler scaleWorkload
	patch /cluster/:cluster/namespace/:namespace/:workload_type/scale (ScaleReq) returns (Response)

  @doc(
		summary: 获取workload副本数
	)
	@handler workloadReplicas
	post /cluster/:cluster/namespace/:namespace/:workload_type/replicas (ReplicaReq) returns (Response)

  @doc(
		summary: 获取workload镜像
	)
	@handler workloadImages
	post /cluster/:cluster/namespace/:namespace/:workload_type/images (ReplicaReq) returns (Response)
	
	@doc(
		summary: 获取yaml配置
	)
	@handler getYaml
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name/yaml (ResourceReq) returns (string)
	
	@doc(
		summary: 删除资源
	)
	@handler deleteResource
	delete /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name (ResourceReq) returns (Response)
	
	@doc(
		summary: 更新yaml
	)
	@handler patchYaml
	patch /cluster/:cluster/namespace/:namespace/apply/yaml (PatchYamlReq) returns (Response)
	
	@doc(
		summary: 更新yaml带variable
	)
	@handler patchVariable
	patch /cluster/:cluster/namespace/:namespace/apply/variable (PatchVariableReq) returns (Response)
	
  @doc(
		summary: 获取resource列表
	)
	@handler listResource
	get /cluster/:cluster/namespace/:namespace/:resource_type (ListResourceReq) returns (Response)
	
  @doc(
		summary: 获取resource信息
	)
	@handler getResource
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name (ResourceReq) returns (Response)
	
	@doc(
		summary: 获取workload Pods信息
	)
	@handler workloadPods
	get /cluster/:cluster/namespace/:namespace/:workload_type/:workload_name/pods (RolloutReq) returns (Response)
	
	@doc(
		summary: 获取Pod事件
	)
	@handler events
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name/events (ResourceReq) returns (Response)

  @doc(
		summary: 获取Pod日志
	)
	@handler podLogs
	get /cluster/:cluster/namespace/:namespace/pods/:pod_name/logs (PodLogReq) returns (string)
	
	@doc(
		summary: 获取部署后Pod状态
	)
	@handler workloadPodStatus
	get /cluster/:cluster/namespace/:namespace/:workload_type/:workload_name/status (RolloutReq) returns (Response)

  @doc(
		summary: 获取资源配额
	)
	@handler resourceQuota
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name/quota (ResourceReq) returns (Response)

  @doc(
		summary: 设置Pod水平扩展
	)
	@handler sethpa
	put /cluster/:cluster/namespace/:namespace/deployments/:workload_name/hpa (HpaReq) returns (Response)

  @doc(
		summary: 获取Pod水平扩展
	)
	@handler gethpa
  get /cluster/:cluster/namespace/:namespace/deployments/:workload_name/hpa (RolloutReq) returns (Response)

  @doc(
		summary: 根据模板换算yaml
	)
	@handler fetchYaml
	post /fetch/yaml (FetchYamlReq) returns (Response)

  @doc(
		summary: 更新configmap
	)
	@handler patchConfigmap
	patch /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name/kv (PatchConfigReq) returns (Response)
}