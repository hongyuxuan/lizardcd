type (
  ExecuteTaskReq {
    Id          string `path:"id"`
    ArtifactUrl string `json:"artifact_url,optional"` 
  }
  TaskStatsReq {
		By       string `form:"by"`
		TimeFrom string `form:"time_from"`
		TimeTill string `form:"time_till"`
	}
  AppHistoryReq {
    Size int `form:"size"`
    Apps string `form:"apps,optional"`
    Sort string `form:"sort"`
  }
  SyncReq {
    AppId int `path:"app_id"`
  }
)

@server(
	prefix: /lizardcd/task
	group: task
	jwt: Auth
  middleware: Validateuser
)
service lizardServer {
	@doc(
		summary: 运行任务
	)
	@handler runTask
	post /run returns (Response)

  @doc(
		summary: 执行任务
	)
	@handler executeTask
	post /execute/:id (ExecuteTaskReq) returns (Response)

  @doc(
		summary: 应用部署统计
	)
	@handler taskstats
	get /stats (TaskStatsReq) returns (Response)

  @doc(
		summary: 根据应用名获取任务历史
	)
	@handler apphistory
	get /history_by_application (AppHistoryReq) returns (Response)
}