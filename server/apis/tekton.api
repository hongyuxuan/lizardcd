type (
  TektontriggerReq {
		ObjectKind string       `json:"object_kind"`
		Before     string       `json:"before,optional"`
		After      string       `json:"after,optional"`
		Ref        string       `json:"ref,optional"`
    User       GitUser       `json:"user,optional"`
		Username   string       `json:"user_username,optional"`
    ObjectAttributes GitObjectAttributes `json:"object_attributes,optional"`
		Project    GitProject   `json:"project"`
		Commits    []GitCommits `json:"commits,optional"`
	}
  GitUser {
    Name     string `json:"name"`
    Username string `json:"username"`
  }
  GitProject {
		Id         int64  `json:"id"`
		Homepage   string `json:"homepage"`
		GitSSHUrl  string `json:"git_ssh_url"`
		GitHttpUrl string `json:"git_http_url"`
	}
	GitCommits {
		Id        string   `json:"id"`
		Message   string   `json:"message,optional"`
		Title     string   `json:"title,optional"`
		Timestamp string   `json:"timestamp,optional"`
    Url       string `json:"url"`
		Added     []string `json:"added,optional"`
		Modified  []string `json:"modified,optional"`
		Removed   []string `json:"removed,optional"`
	}
  GitObjectAttributes {
    TargetBranch string `json:"target_branch"`
    IId int64 `json:"iid"`
    Url string `json:"url"`
    MergeCommitSha *string `json:"merge_commit_sha,optional"`
    MergeStatus *string `json:"merge_status,optional"`
    DetailedMergeStatus *string `json:"detailed_merge_status,optional"`
    LastCommit *GitCommits `json:"last_commit,optional"`
    Action *string `json:"action,optional"`
  }
  TemplateReq {
    TemplateId int `path:"id"`
    ResourceType string `path:"resource_type"`
    Variables map[string]interface{} `json:"variables"`
  }
)

@server(
	prefix: /lizardcd/tekton
	group: tekton
	jwt: Auth
  middleware: Validateuser
)
service lizardServer {
	@doc(
		summary: 获取tekton endpoint
	)
	@handler getTektonEndpoint
	get /cluster/:cluster/namespace/:namespace/endpoint (PatchYamlReq) returns (Response)
  @doc(
		summary: 获取tekton资源列表
	)
	@handler listTektonResource
	get /cluster/:cluster/namespace/:namespace/:resource_type (ListResourceReq) returns (Response)
  @doc(
		summary: 获取tekton资源
	)
	@handler getTektonResource
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name (ResourceReq) returns (Response)
  @doc(
		summary: 修改tekton资源
	)
	@handler patchTektonResource
	patch /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name (ResourceReq) returns (Response)
  @doc(
		summary: 获取tekton资源yaml
	)
	@handler getTektonYaml
	get /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name/yaml (ResourceReq) returns (Response)
  @doc(
		summary: 删除tekton资源
	)
	@handler deleteTekton
	delete /cluster/:cluster/namespace/:namespace/:resource_type/:resource_name (ResourceReq) returns (Response)
  @doc(
		summary: 通过go-template创建/更新tekton资源
	)
	@handler applyTekton
	post /cluster/:cluster/namespace/:namespace/apply (PatchVariableReq) returns (Response)
}

@server(
	prefix: /lizardcd/tekton
	group: tekton
)
service lizardServer {
  @doc(
		summary: 根据应用路径触发以EventListener方式部署
	)
	@handler trigger
	post /trigger (TektontriggerReq) returns (Response)

  @doc(
		summary: 根据应用路径触发以PipelineRun方式部署
	)
	@handler triggerpipelinerun
	post /trigger/pipelinerun (TektontriggerReq) returns (Response)
}